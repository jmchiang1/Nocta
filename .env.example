# Copy to .env.local (git-ignored) and fill in from Supabase › Project Settings › API Keys.
# Leave both empty to run on the mock sign-in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). Never put the secret / service_role key here:
# anything prefixed VITE_ ships to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
